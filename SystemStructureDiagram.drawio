        </mxCell>
        <mxCell id="vyHls2FTnKNsInNVu_F4-5" value="Can access the protected reference counting (included_in) methods of Record object types via RecordAttorney." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="vyHls2FTnKNsInNVu_F4-3" vertex="1">
          <mxGeometry y="70" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vyHls2FTnKNsInNVu_F4-6" value="Creates new Record objects, allocates memory for them and increments/decrements their included_in counter." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="vyHls2FTnKNsInNVu_F4-3" vertex="1">
          <mxGeometry y="120" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vyHls2FTnKNsInNVu_F4-28" value="Deallocates memory for Record objects if the pointer to the record is to be deleted and the pointer to it is the last remaining pointer (defined by the value of the Record object&#39;s included_in)." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="vyHls2FTnKNsInNVu_F4-3" vertex="1">
