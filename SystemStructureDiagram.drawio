        <mxCell id="vyHls2FTnKNsInNVu_F4-40" value="Holds data for a particular field. One field object will only be contained in one class, so memory does not need to be manually allocated or deallocated for it." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="vyHls2FTnKNsInNVu_F4-39" vertex="1">
