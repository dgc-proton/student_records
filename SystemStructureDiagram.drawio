        <mxCell id="vyHls2FTnKNsInNVu_F4-4" value="Contains pointers to multiple objects of one particular child class of BasicRecord." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="vyHls2FTnKNsInNVu_F4-3" vertex="1">
