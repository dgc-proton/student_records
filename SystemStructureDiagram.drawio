        <mxCell id="vyHls2FTnKNsInNVu_F4-35" value="Keeps a count (included_in) of how many RecordArray or RecordLinkedList objects hold pointers to it." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="vyHls2FTnKNsInNVu_F4-34" vertex="1">
